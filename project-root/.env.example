# Copy to .env for local development. On Railway, set these in the service's Variables tab.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pyk
# Set to true only when connecting to Railway's *public* Postgres URL from outside Railway.
DATABASE_SSL=false
# Where uploaded PDFs go. On Railway, mount a volume and set this to e.g. /data/uploads.
UPLOAD_DIR=server/data/uploads
PORT=3000
